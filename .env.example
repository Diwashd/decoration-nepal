# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Keep this low for serverless deployments such as Vercel.
DB_POOL_MAX=1

# Supabase Storage (required for persistent uploads on Vercel)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# Authentication secrets
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# App configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="11:11 Decoration Nepal"

# Optional SEO and analytics settings
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-search-console-token
# NEXT_PUBLIC_GA_ID=G-your-google-analytics-id
# NEXT_PUBLIC_GTM_ID=your-google-tag-manager-id
